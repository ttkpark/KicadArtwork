  98:Core/Src/main.c ****   /* Layout: title, then 3 columns centered - label, circle, 0/1 */
  99:Core/Src/main.c ****   /* Column centers: 24, 64, 104. Circle radius 8, center y=28. Label y=10, digit y=40 */
 100:Core/Src/main.c ****   #define CPLD_CX0  24
 101:Core/Src/main.c ****   #define CPLD_CX1  64
 102:Core/Src/main.c ****   #define CPLD_CX2  104
 103:Core/Src/main.c ****   #define CPLD_CY   28
 104:Core/Src/main.c ****   #define CPLD_R    8
 105:Core/Src/main.c ****   #define LABEL_Y   10
 106:Core/Src/main.c ****   #define DIGIT_Y   40
 107:Core/Src/main.c ****   #define BOX_X0    4
 108:Core/Src/main.c ****   #define BOX_X1    44
 109:Core/Src/main.c ****   #define BOX_X2    84
 110:Core/Src/main.c ****   #define BOX_X3    124
 111:Core/Src/main.c ****   #define BOX_Y0    18
 112:Core/Src/main.c ****   #define BOX_Y1    52
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****   /* Static frame: border + title + labels */
 115:Core/Src/main.c ****   OLED_DrawRect(0, 0, OLED_WIDTH - 1, OLED_HEIGHT - 1);
 116:Core/Src/main.c ****   OLED_DrawString(36, 0, "CPLD MON");
 117:Core/Src/main.c ****   OLED_DrawString(14, LABEL_Y, "IO28");
 118:Core/Src/main.c ****   OLED_DrawString(54, LABEL_Y, "IO33");
 119:Core/Src/main.c ****   OLED_DrawString(94, LABEL_Y, "IO34");
 120:Core/Src/main.c ****   OLED_Refresh();
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****   /* USER CODE END 2 */
 123:Core/Src/main.c **** 
 124:Core/Src/main.c ****   /* Infinite loop */
 125:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 126:Core/Src/main.c ****   while (1)
 127:Core/Src/main.c ****   {
 128:Core/Src/main.c ****     /* USER CODE END WHILE */
 129:Core/Src/main.c **** 
 130:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 131:Core/Src/main.c ****     /* Read PA3, PA11, PA12 (CPLD IO28, IO33, IO34) */
 132:Core/Src/main.c ****     GPIO_PinState s0 = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_3);
 133:Core/Src/main.c ****     GPIO_PinState s1 = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_11);
 134:Core/Src/main.c ****     GPIO_PinState s2 = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_12);
 135:Core/Src/main.c **** 
 136:Core/Src/main.c ****     /* Clear circle + digit area for each column */
 137:Core/Src/main.c ****     OLED_ClearRect(BOX_X0, BOX_Y0, BOX_X1, BOX_Y1);
 138:Core/Src/main.c ****     OLED_ClearRect(BOX_X1 + 2, BOX_Y0, BOX_X2, BOX_Y1);
 139:Core/Src/main.c ****     OLED_ClearRect(BOX_X2 + 2, BOX_Y0, BOX_X3, BOX_Y1);
 140:Core/Src/main.c **** 
 141:Core/Src/main.c ****     /* Redraw circles: LOW = hollow, HIGH = filled */
 142:Core/Src/main.c ****     OLED_DrawCircle(CPLD_CX0, CPLD_CY, CPLD_R, (s0 == GPIO_PIN_SET));
 143:Core/Src/main.c ****     OLED_DrawCircle(CPLD_CX1, CPLD_CY, CPLD_R, (s1 == GPIO_PIN_SET));
 144:Core/Src/main.c ****     OLED_DrawCircle(CPLD_CX2, CPLD_CY, CPLD_R, (s2 == GPIO_PIN_SET));
 145:Core/Src/main.c **** 
 146:Core/Src/main.c ****     /* 0 or 1 below each circle (centered: 6px font, so -3 from center) */
