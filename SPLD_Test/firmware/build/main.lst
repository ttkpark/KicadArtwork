 147:Core/Src/main.c ****     OLED_DrawChar(CPLD_CX0 - 3, DIGIT_Y, (s0 == GPIO_PIN_SET) ? '1' : '0');
 148:Core/Src/main.c ****     OLED_DrawChar(CPLD_CX1 - 3, DIGIT_Y, (s1 == GPIO_PIN_SET) ? '1' : '0');
 149:Core/Src/main.c ****     OLED_DrawChar(CPLD_CX2 - 3, DIGIT_Y, (s2 == GPIO_PIN_SET) ? '1' : '0');
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****     OLED_Refresh();
 152:Core/Src/main.c ****     HAL_Delay(80);
 153:Core/Src/main.c ****   }
