  61:Core/Src/oled_sh1106.c ****   WriteCmd(0x20); WriteCmd(0x02); /* page addressing mode */
  62:Core/Src/oled_sh1106.c ****   WriteCmd(0xA6); /* normal display */
  63:Core/Src/oled_sh1106.c ****   WriteCmd(0xAF); /* display on */
