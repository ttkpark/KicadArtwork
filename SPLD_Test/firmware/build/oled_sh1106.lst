  56:Core/Src/oled_sh1106.c ****   WriteCmd(0x81); WriteCmd(0x7F); /* contrast */
  57:Core/Src/oled_sh1106.c ****   WriteCmd(0xD5); WriteCmd(0x80); /* clock divide */
  58:Core/Src/oled_sh1106.c ****   WriteCmd(0xD9); WriteCmd(0x22); /* precharge */
  59:Core/Src/oled_sh1106.c ****   WriteCmd(0xDB); WriteCmd(0x20); /* Vcomh */
