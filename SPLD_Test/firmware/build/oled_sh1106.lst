  48:Core/Src/oled_sh1106.c **** 
  49:Core/Src/oled_sh1106.c ****   WriteCmd(0xAE); /* display off */
  50:Core/Src/oled_sh1106.c ****   WriteCmd(0xA8); WriteCmd(0x3F); /* multiplex 64-1 */
  51:Core/Src/oled_sh1106.c ****   WriteCmd(0xD3); WriteCmd(0x00); /* display offset */
  52:Core/Src/oled_sh1106.c ****   WriteCmd(0x40); /* display start line 0 */
  53:Core/Src/oled_sh1106.c ****   WriteCmd(0xA0); /* segment remap: 0xA0=SEG0->col0, 0xA1=flipped (was 0xA1) */
  54:Core/Src/oled_sh1106.c ****   WriteCmd(0xC8); /* COM scan reversed (COM63->COM0): 0xC0=normal, 0xC8=flipped (was 0xC0) */
