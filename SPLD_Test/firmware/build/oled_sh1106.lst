  42:Core/Src/oled_sh1106.c ****   /* RST pulse - GPIO initialized by MX_GPIO_Init */
  43:Core/Src/oled_sh1106.c ****   HAL_GPIO_WritePin(OLED_NSS_GPIO_Port, OLED_NSS_Pin, GPIO_PIN_SET);
  44:Core/Src/oled_sh1106.c ****   HAL_GPIO_WritePin(OLED_RST_GPIO_Port, OLED_RST_Pin, GPIO_PIN_RESET);
  45:Core/Src/oled_sh1106.c ****   HAL_Delay(10);
